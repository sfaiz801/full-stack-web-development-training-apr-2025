# ==========================================================
# Full Stack Training Repository - Master .gitignore
# ==========================================================

# 1. Node.js Dependencies (CRITICAL: NEVER COMMIT TO GIT)
node_modules/
*/node_modules/
*/*/node_modules/
*/*/*/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 2. Next.js, React & Frontend Build Outputs
.next/
*/.next/
*/*/.next/
out/
dist/
*/dist/
*/*/dist/
build/
*/build/
.vercel/

# 3. Python Cache & Virtual Environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/

# 4. Compiled C / C++ Binaries
*.exe
*.out
*.o
*.obj
*.pdb
*.ilk
*.suo

# 5. Environment Secrets & API Credentials
.env
.env*.local
*.env
*firebase_credentials*.json
*serviceAccountKey*.json

# 6. Editor & Operating System Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
tempCodeRunnerFile.*
